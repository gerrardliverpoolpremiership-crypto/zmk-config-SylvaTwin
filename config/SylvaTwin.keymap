#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        prtsc {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <10 11>;
        };

        RightClick {
            bindings = <&mkp RCLK>;
            key-positions = <30 44>;
        };

        MiddleClick {
            bindings = <&mkp MCLK>;
            key-positions = <29 43>;
        };

        RightClick2 {
            bindings = <&mkp RCLK>;
            key-positions = <31 45>;
        };

        MiddleClick2 {
            bindings = <&mkp MCLK>;
            key-positions = <32 46>;
        };

        zen-han {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <42 28>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <41 27>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <40 26>;
        };

        prev_click {
            bindings = <&mkp MB4>;
            key-positions = <29 30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB     &kp Q     &kp W     &kp E  &kp R  &kp T                        &kp Y      &kp U      &kp I      &kp O    &kp P      &kp BSPC
&kp CAPS    &kp A     &kp S     &kp D  &kp F  &kp G                        &kp H      &kp J      &kp K      &kp L    &kp MINUS  &kp ENTER
&kp LSHIFT  &kp Z     &kp X     &kp C  &kp V  &kp B  &mkp LCLK  &mkp LCLK  &kp N      &kp M      &kp COMMA  &kp DOT  &kp SLASH  &kp F10
&kp LCTRL   &kp LGUI  &kp LALT  &mo 5  &mo 2  &mo 1  &kp SPACE  &kp SPACE  &kp EQUAL  &kp MINUS  &mo 4      &kp DEL  &kp F7     &kp F4
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans          &kp UP_ARROW    &trans           &trans                     &mkp RCLK            &mo 4   &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans                     &mkp MCLK            &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &mkp LCLK  &kp LA(LEFT_ARROW)   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans     &kp LA(RIGHT_ARROW)  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6   &kp NUMBER_7          &kp NUMBER_8      &kp NUMBER_9       &kp NUMBER_0    &kp DELETE
&none       &none         &none         &none         &kp LS(SEMI)  &kp LS(MINUS)                 &kp LS(EQUAL)  &kp LS(SINGLE_QUOTE)  &trans            &trans             &kp LS(GRAVE)   &trans
&none       &none         &none         &none         &none         &none          &none  &trans  &trans         &trans                &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp UP_ARROW    &trans
&none       &none         &none         &none         &none         &none          &none  &trans  &trans         &trans                &trans            &kp LEFT_ARROW     &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                  &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)  &trans
&trans  &trans            &trans            &trans            &kp SEMICOLON     &kp MINUS                         &kp EQUAL         &kp SINGLE_QUOTE  &trans            &trans            &kp GRAVE         &trans
&trans  &trans            &trans            &trans            &trans            &trans            &trans  &trans  &trans            &trans            &trans            &trans            &trans            &trans
&trans  &trans            &trans            &trans            &trans            &trans            &trans  &trans  &trans            &trans            &trans            &trans            &trans            &trans
            >;
        };

        layer_5 {
            bindings = <
&trans        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                          &kp F6  &kp F7  &kp F8  &kp F9  &kp F10        &trans
&bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans         &trans
&bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &kp BACKSLASH  &trans
&bt BT_SEL 3  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans         &trans
            >;
        };
    };
};
